---
interface Props {
  current?: "shop" | "about" | "contact" | "admin" | "cart" | "account";
}

const { current } = Astro.props;
---

<header class="site-header" transition:persist>
  <div class="site-header-main">
    <a class="brand-mark" href="/" aria-label="Shkeeno home">SHKEENO</a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href="/shop" aria-current={current === "shop" ? "page" : undefined}>Shop</a>
      <a href="/about" aria-current={current === "about" ? "page" : undefined}>About</a>
      <a href="/contact" aria-current={current === "contact" ? "page" : undefined}>Contact</a>
    </nav>
    <div class="site-actions" aria-label="Account, cart, and theme">
      <a class="site-action-link" href="/account" aria-current={current === "account" ? "page" : undefined}>
        Account <span data-account-badge data-empty="true" aria-hidden="true"></span>
      </a>
      <a class="site-action-link" href="/cart" aria-current={current === "cart" ? "page" : undefined}>
        Cart <span data-cart-count data-empty="true" aria-hidden="true"></span>
      </a>
      <button type="button" class="theme-toggle-button" data-theme-toggle aria-label="Switch to dark mode" title="Toggle theme">
        <span data-theme-icon aria-hidden="true">
          <svg viewBox="0 0 24 24" role="presentation" focusable="false">
            <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8" />
            <path d="M12 2.75v3.1M12 18.15v3.1M21.25 12h-3.1M5.85 12H2.75M18.54 5.46l-2.19 2.19M7.65 16.35l-2.19 2.19M18.54 18.54l-2.19-2.19M7.65 7.65L5.46 5.46" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
          </svg>
        </span>
      </button>
    </div>
    <div class="mobile-actions">
      <a class="mobile-cart-link" href="/cart" aria-label="Cart">
        <svg viewBox="0 0 24 24" class="cart-icon" aria-hidden="true" role="presentation" focusable="false">
          <path d="M6.6 8.5h10.8l-.7 10H7.3l-.7-10Z" fill="none" stroke="currentColor" stroke-width="1.9" />
          <path d="M9 8.5a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="square" />
        </svg>
        <span class="sr-only">Cart</span>
        <span data-cart-count data-empty="true" aria-hidden="true"></span>
      </a>
      <button
        type="button"
        class="mobile-menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hamburger-icon" aria-hidden="true"></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile navigation">
      <a href="/shop" aria-current={current === "shop" ? "page" : undefined}>Shop all</a>
      <a class="mobile-category-link" href="/shop?category=edc">EDC</a>
      <a class="mobile-category-link" href="/shop?category=office">Office</a>
      <a class="mobile-category-link" href="/shop?category=pocket">Pocket</a>
      <a class="mobile-category-link" href="/shop?category=travel">Travel</a>
      <a href="/about" aria-current={current === "about" ? "page" : undefined}>About</a>
      <a href="/contact" aria-current={current === "contact" ? "page" : undefined}>Contact</a>
      <a href="/account" aria-current={current === "account" ? "page" : undefined}>
        Account <span data-account-badge data-empty="true" aria-hidden="true"></span>
      </a>
    </nav>
    <button type="button" class="mobile-theme-toggle" data-theme-toggle aria-label="Switch to dark mode">
      <span>Theme</span>
      <span data-theme-icon aria-hidden="true">
        <svg viewBox="0 0 24 24" role="presentation" focusable="false">
          <circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8" />
          <path d="M12 2.75v3.1M12 18.15v3.1M21.25 12h-3.1M5.85 12H2.75M18.54 5.46l-2.19 2.19M7.65 16.35l-2.19 2.19M18.54 18.54l-2.19-2.19M7.65 7.65L5.46 5.46" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" />
        </svg>
      </span>
    </button>
  </div>
  <button type="button" class="mobile-menu-backdrop" data-menu-backdrop aria-label="Close menu" hidden></button>
  <slot />
</header>
