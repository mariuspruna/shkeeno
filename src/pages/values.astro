---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTrail from "../components/PageTrail.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { valuesPages } from "../lib/values-pages";
---

<BaseLayout
  title="Values | Shkeeno"
  description="Values and commitments behind Shkeeno."
>
  <SiteHeader current="values" />

  <main class="shop-shell about-shell">
    <PageTrail items={[{ label: "Values" }]} />

    <section class="about-intro" aria-labelledby="values-title">
      <h1 id="values-title">Values</h1>
      <div>
        <p>
          Shkeeno’s values are being written while the brand is still young, which is the right
          moment to do it. The aim is to grow with care: considered pieces, clear communication,
          respectful creative work, and practical choices that do not pretend to be more polished
          than they are.
        </p>
        <p>
          These pages are a draft framework for Diana to refine. They keep the tone honest for now,
          and leave space for exact policies, suppliers, charity partners, and service details once
          those decisions are ready.
        </p>
      </div>
    </section>

    <section class="about-faq" aria-labelledby="values-pages-title">
      <h2 id="values-pages-title">Explore values</h2>
      <div class="faq-list">
        {valuesPages.map((page) => (
          <a class="faq-item values-link-card" href={`/values/${page.slug}`}>
            <span>{page.title}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
