---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout title="Menu | SHKEENO">
  <SiteHeader current="menu" />
  <main class="content-page">
    <p class="eyebrow">Menu</p>
    <h1>Browse future collection areas.</h1>
    <div class="shkeeno-card-grid">
      {["New in", "Wish list", "Pre-order", "Sale"].map((title) => (
        <article class="shkeeno-card">
          <div class="shkeeno-image-placeholder"><span>{title}</span></div>
          <h2>{title}</h2>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
