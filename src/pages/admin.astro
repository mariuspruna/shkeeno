---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout title="Admin | SHKEENO">
  <SiteHeader current="admin" />
  <main class="admin-page">
    <aside class="admin-card">
      <p class="eyebrow">Admin</p>
      <h1>Design controls</h1>
      <p>This is the first Shkeeno admin shell, ready for future brand and content controls.</p>
    </aside>
    <section class="admin-card admin-control-grid">
      <label>Primary color <input type="color" value="#202020" /></label>
      <label>Accent color <input type="color" value="#007f7a" /></label>
      <label>Background <input type="color" value="#f3f0e8" /></label>
    </section>
  </main>
</BaseLayout>
