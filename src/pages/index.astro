---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout>
  <SiteHeader current="home" />

  <main>
    <section class="shkeeno-hero" aria-labelledby="home-title">
      <div class="shkeeno-hero-copy">
        <p class="eyebrow">Independent fashion label</p>
        <h1 id="home-title">Designer-led fashion with a graphic pulse and a softer edge.</h1>
        <p>
          SHKEENO is an emerging fashion identity by Diana Baptista, built around expressive,
          individual pieces and a contemporary designer-led point of view.
        </p>
      </div>
      <div class="shkeeno-image-placeholder shkeeno-hero-media">
        <span>Campaign image</span>
      </div>
    </section>

    <section class="shkeeno-section-grid" aria-labelledby="intro-title">
      <article>
        <p class="eyebrow">About Shkeeno</p>
        <h2 id="intro-title">A brand presence first, with room for collections and commerce later.</h2>
        <p>
          The website should prioritise Diana's identity, collections, imagery and storytelling before
          becoming a conventional shop catalogue.
        </p>
      </article>
      <article>
        <p class="eyebrow">The idea</p>
        <h2>Fashion-forward, feminine and strong, without visual noise.</h2>
        <p>
          Bold graphic references, organic softness and editorial restraint form the starting visual language.
        </p>
      </article>
    </section>

    <section class="shkeeno-portfolio-preview" aria-labelledby="portfolio-title">
      <div class="section-heading">
        <p class="eyebrow">Portfolio</p>
        <h2 id="portfolio-title">A first structure for future collections.</h2>
      </div>
      <div class="shkeeno-card-grid">
        {["New in", "Pre-order", "Portfolio", "Sale"].map((title) => (
          <article class="shkeeno-card">
            <div class="shkeeno-image-placeholder">
              <span>{title}</span>
            </div>
            <h3>{title}</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
