---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { getPublishedProducts } from "../lib/supabase";
import { toTitleCase } from "../lib/text";

const published = await getPublishedProducts();
const featuredSeed = published.filter((product) => product.is_featured);
const featuredSource = (featuredSeed.length >= 3 ? featuredSeed : published).slice(0, 3);

const formatPrice = (value: number) => Number(value || 0).toFixed(2);

const featuredObjects = featuredSource.map((product) => {
  const image = [...(product.product_images || [])]
    .sort((a, b) => a.sort_order - b.sort_order)[0];

  return {
    ...product,
    displayName: toTitleCase(product.name),
    imageUrl: image?.url || "",
  };
});
---

<BaseLayout title="Shkeeno | Designer-led fashion">
  <SiteHeader />

  <main>
    <section class="home-featured" aria-labelledby="featured-title">
      <h1 id="featured-title">Designer-led fashion with a graphic pulse.</h1>
      <div class="home-featured-grid">
        {
          featuredObjects.length > 0 ? featuredObjects.map((object) => (
            <article class="home-feature-card">
              <div class="home-feature-media">
                <div class="gallery-viewport">
                  <a
                    href={`/shop/${object.slug}`}
                    class:list={["product-image", { "has-image": Boolean(object.imageUrl) }]}
                    style={object.imageUrl ? `--product-image: url('${object.imageUrl}')` : undefined}
                    aria-label={`View ${object.displayName}`}
                  />
                </div>
              </div>
              <div class="home-feature-copy">
                <p class="eyebrow home-feature-provenance">
                  <span>{object.brand || object.category || "Shkeeno"}</span>
                  {object.origin_country && <span class="meta-origin">{object.origin_country}</span>}
                </p>
                <h3><a href={`/shop/${object.slug}`}>{object.displayName}</a></h3>
                <p>{object.short_description}</p>
                <div class="home-feature-meta">
                  <strong>£{formatPrice(object.price_gbp)}</strong>
                </div>
              </div>
            </article>
          )) : (
            <section class="empty-state">
              <p>No published products yet.</p>
              <a href="/admin/products">Open catalogue admin</a>
            </section>
          )
        }
      </div>
      <div class="home-featured-bridge">
        <h2>Browse the full collection</h2>
        <p>
          This is the first Shkeeno foundation: a brand presence, catalogue, newsletter and
          commerce structure ready for Diana Baptista’s collections.
        </p>
        <a href="/shop" class="reset-button home-feature-cta">Browse our collection</a>
      </div>
    </section>

  </main>
</BaseLayout>
