---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Shkeeno Words"
  description="A private word tile game for Shkeeno."
>
  <main class="word-game-shell" data-word-game>
    <section class="word-game-hero">
      <a class="brand-mark word-game-brand" href="/" aria-label="Shkeeno home">SHKEENO</a>
      <div>
        <p class="eyebrow">Private wordboard</p>
        <h1>Shkeeno Words</h1>
        <p>
          A tiny board, a bag of letters, and a very serious excuse to play one more turn.
        </p>
      </div>
    </section>

    <section class="word-game-lobby" data-game-lobby>
      <div class="settings-card">
        <h2>Create a game</h2>
        <form data-create-game-form class="word-game-form">
          <label>
            <span>Your name</span>
            <input name="name" type="text" value="Marius" autocomplete="name" />
          </label>
          <label>
            <span>Players</span>
            <select name="max_players">
              <option value="2">2 players</option>
              <option value="3">3 players</option>
              <option value="4">4 players</option>
            </select>
          </label>
          <button class="reset-button" type="submit">Create game</button>
        </form>
      </div>

      <div class="settings-card">
        <h2>Join a game</h2>
        <form data-join-game-form class="word-game-form">
          <label>
            <span>Game code</span>
            <input name="code" type="text" inputmode="text" autocomplete="off" />
          </label>
          <label>
            <span>Your name</span>
            <input name="name" type="text" value="Diana" autocomplete="name" />
          </label>
          <button class="reset-button" type="submit">Join game</button>
        </form>
      </div>

      <div class="settings-card">
        <h2>Restore seat</h2>
        <p>
          Closed the tab? Use the same game code and the same player name to get your rack back.
        </p>
        <form data-restore-game-form class="word-game-form">
          <label>
            <span>Game code</span>
            <input name="code" type="text" inputmode="text" autocomplete="off" />
          </label>
          <label>
            <span>Your player name</span>
            <input name="name" type="text" autocomplete="name" />
          </label>
          <button class="reset-button" type="submit">Restore game</button>
        </form>
      </div>
    </section>

    <p class="catalog-status word-game-status" data-word-game-status hidden></p>

    <section class="word-game-table" data-game-table hidden>
      <div class="word-game-topbar">
        <div>
          <p class="eyebrow">Game <span data-game-code>------</span></p>
          <p data-game-status>Waiting for players.</p>
        </div>
        <div class="word-invite-actions">
          <button class="back-link" type="button" data-copy-code>Copy code</button>
          <button class="back-link" type="button" data-copy-invite>Copy invite</button>
          <button class="back-link" type="button" data-share-invite>Share</button>
        </div>
      </div>

      <div class="word-scoreboard" data-scoreboard></div>

      <div class="word-game-meta">
        <span>Bag: <strong data-bag-count>0</strong></span>
        <span>Preview: <strong data-preview-score>0</strong></span>
        <span data-word-validity>Place tiles to begin.</span>
      </div>

      <div class="word-board-wrap">
        <div class="word-board" data-word-board aria-label="Word board"></div>
      </div>

      <div class="word-rack-panel">
        <div class="word-rack" data-word-rack aria-label="Your tile tray"></div>
        <div class="word-game-actions">
          <button type="button" class="back-link" data-move-left>Move left</button>
          <button type="button" class="back-link" data-move-right>Move right</button>
          <button type="button" class="back-link" data-withdraw>Withdraw all</button>
          <button type="button" class="back-link" data-exchange-mode>Mark exchange</button>
          <button type="button" class="back-link" data-exchange>Exchange selected</button>
          <button type="button" class="back-link" data-pass>Pass</button>
          <button type="button" class="back-link" data-nudge>Nudge</button>
          <button type="button" class="back-link" data-resign>Resign</button>
          <button type="button" class="reset-button" data-submit-turn>Submit</button>
        </div>
      </div>

      <section class="word-history">
        <h2>Recent moves</h2>
        <ol data-word-history></ol>
      </section>
    </section>
  </main>
  <script type="module" src="/scripts/word-game.js"></script>
</BaseLayout>
