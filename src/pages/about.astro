---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageTrail from "../components/PageTrail.astro";
import SiteHeader from "../components/SiteHeader.astro";

const faqs = [
  {
    question: "Is Shkeeno a designer-led label?",
    answer:
      "Yes. Shkeeno is a designer-led label with a clear visual point of view, built around expressive pieces and small collections.",
  },
  {
    question: "Where do you ship from?",
    answer:
      "Orders ship from the United Kingdom. We use tracked delivery and follow up by email when the order moves.",
  },
  {
    question: "How long does delivery take?",
    answer:
      "As a rough guide, UK delivery usually takes 1-2 days after dispatch. International delivery outside the UK usually takes 7-14 days, depending on destination and customs.",
  },
  {
    question: "Which currency do you charge in?",
    answer:
      "Checkout is in pounds sterling (£). Stripe may show local payment options depending on the customer and region, but the store currency stays British pounds.",
  },
  {
    question: "Are these your own products?",
    answer:
      "Yes. The shop is built for Shkeeno pieces, services, pre-orders, and limited releases as the catalogue grows.",
  },
  {
    question: "How do you take payments?",
    answer:
      "Payments are processed securely through Stripe. We do not store card details on Shkeeno.",
  },
];
---

<BaseLayout
  title="About | Shkeeno"
  description="About Shkeeno, the independent fashion label by designer Diana Baptista."
>
  <SiteHeader current="about" />

  <main class="shop-shell about-shell">
    <PageTrail items={[{ label: "About" }]} />

    <section class="about-intro" aria-labelledby="about-title">
      <h1 id="about-title">A designer-led fashion identity.</h1>
      <div>
        <p>
          Shkeeno is an independent fashion label with a studio feel: expressive, graphic, and built
          around pieces with character.
        </p>
        <p>
          The brand sits somewhere between a portfolio, a young label, and a future shop. It is
          visual first, but practical enough to hold collections, services, pre-orders, and small
          releases as they arrive.
        </p>
        <p>
          Diana Baptista is the designer behind Shkeeno. Her story matters, but the brand is bigger
          than a biography: it is a world for the work to grow into.
        </p>
      </div>
    </section>

    <section class="about-faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Practical questions</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
      <div class="about-contact-cta">
        <p>Still wondering about something?</p>
        <a href="/contact">Contact us</a>
      </div>
    </section>
  </main>
</BaseLayout>
